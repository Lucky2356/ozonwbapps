{
  "name": "ozonwbapps",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000, 5173, 8080, 5433, 6379],
  "portsAttributes": {
    "5173": { "label": "web (Vite)", "onAutoForward": "openPreview" },
    "3000": { "label": "api (NestJS)" },
    "8080": { "label": "web (prod nginx)" },
    "5433": { "label": "PostgreSQL" },
    "6379": { "label": "Redis" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Prisma.prisma"
      ]
    }
  }
}
