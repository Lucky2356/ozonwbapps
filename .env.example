# ---------------------------------------------------------------------------
# Общие переменные окружения проекта ozonwbapps.
# Скопируйте этот файл в .env и при необходимости измените значения.
# Секреты в репозиторий не коммитим.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=ozonwb
POSTGRES_PASSWORD=ozonwb_password
POSTGRES_DB=ozonwb
# DATABASE_URL используется Prisma (api + worker).
# Для docker compose host = postgres, для локального запуска = localhost.
DATABASE_URL=postgresql://ozonwb:ozonwb_password@postgres:5432/ozonwb?schema=public

# --- Redis (очередь BullMQ + кеш парсера) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- API ---
API_PORT=3000
# Поменяйте на длинную случайную строку в проде!
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
# CORS: адреса фронтенда (через запятую): Vite dev (5173) и web-контейнер (8080)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- Worker / парсинг ---
# Включённые маркетплейсы (через запятую): ozon,wildberries,yandex_market,dns,mvideo
# yandex_market, dns и mvideo по умолчанию выключены (сильная анти-бот-защита) — включайте на «чистом» RU-IP.
ENABLED_MARKETPLACES=ozon,wildberries
# TTL кеша результатов парсинга, секунды
PARSER_CACHE_TTL=900
# Сколько товаров максимум собирать с каждого маркетплейса
PARSER_MAX_ITEMS=60
# Пауза между запросами к одному маркетплейсу, мс (вежливость)
PARSER_REQUEST_DELAY_MS=800
# Wildberries: регион доставки (dest) и версия search API
WB_DEST=-1257786
WB_SEARCH_VERSION=v13
# WB отдаёт товары только обычному (не-headless) браузеру — при поиске WB кратко
# открывается окно браузера. На сервере без дисплея: запускайте worker через xvfb-run,
# либо WB_HEADLESS=1 (тогда WB вернёт пусто, Ozon продолжит работать).
WB_HEADLESS=0
# Ozon: запускать ли Playwright (на сервере без браузера можно выключить)
OZON_ENABLED=true
OZON_TIMEOUT_MS=30000
# Яндекс.Маркет: headless по умолчанию; на «чистом» RU-IP можно YM_HEADLESS=0 (надёжнее против капчи)
YM_HEADLESS=1
YM_TIMEOUT_MS=30000
# DNS (dns-shop.ru): headless по умолчанию; на «чистом» RU-IP можно DNS_HEADLESS=0 (надёжнее против DDoS-Guard)
DNS_HEADLESS=1
DNS_TIMEOUT_MS=30000
# М.Видео (mvideo.ru): headless по умолчанию; на «чистом» RU-IP можно MV_HEADLESS=0 (надёжнее против капчи)
MV_HEADLESS=1
MV_TIMEOUT_MS=30000

# --- Отслеживание цен (cron пересбора) ---
# Интервал проверки цен отслеживаемых товаров, минуты (0 = выключить)
PRICE_CHECK_INTERVAL_MIN=360
# Задержка перед первым прогоном после старта воркера, секунды
PRICE_CHECK_INITIAL_DELAY_SEC=60

# --- Уведомления / Telegram-бот ---
# Токен бота от @BotFather. Пусто = Telegram-уведомления и бот выключены (остаются только в приложении).
TELEGRAM_BOT_TOKEN=
# Username бота без @ (для deep-link привязки). Если не задан — берётся автоматически через getMe.
TELEGRAM_BOT_USERNAME=
# Час (0..23, локальное время сервера), когда отправлять дайджест снижений цен в Telegram.
DIGEST_HOUR=9

# --- «Найти дешевле»: поиск того же товара дешевле на других маркетплейсах ---
# Интервал, минуты (0 = выключено). Включайте на «чистом» RU-IP — это полноценные поиски.
FINDCHEAPER_INTERVAL_MIN=0
# Порог схожести названий 0..1 для совпадения товара (выше — строже).
FINDCHEAPER_SIMILARITY=0.5

# --- Scoring (веса можно менять; сумма не обязательно = 1, нормируется) ---
SCORE_WEIGHT_PRICE=0.4
SCORE_WEIGHT_RATING=0.25
SCORE_WEIGHT_REVIEWS=0.15
SCORE_WEIGHT_DISCOUNT=0.1
SCORE_WEIGHT_SELLER=0.1

# --- Frontend (Vite) ---
# Базовый URL API для фронтенда
VITE_API_URL=http://localhost:3000
